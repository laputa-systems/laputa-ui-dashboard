{
  "name": "@joshuarli/ui",
  "version": "0.2.0",
  "description": "Compact, editorial design system primitives for Solid",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsrs -p tsconfig.json && node -e \"import('node:fs').then(fs => { fs.copyFileSync('src/tokens.css', 'dist/tokens.css'); fs.copyFileSync('src/styles.css', 'dist/styles.css'); })\"",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.18",
    "solid-js": ">=2.0.0-rc.18"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@solidjs/web": "2.0.0-rc.20",
    "solid-js": "2.0.0-rc.20",
    "tsrs": "0.20.1-ts7.1.0-beta",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
