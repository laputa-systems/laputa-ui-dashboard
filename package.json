{
  "name": "@laputa-systems/ui-dashboard",
  "version": "0.9.0",
  "description": "Compact, editorial dashboard design system: CSS tokens and styles with optional Solid primitives",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/laputa-systems/laputa-ui-dashboard.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/ssr/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./forms": {
      "types": "./dist/forms/index.d.ts",
      "browser": "./dist/forms.js",
      "node": "./dist/ssr/forms.js",
      "import": "./dist/forms.js",
      "default": "./dist/forms.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "browser": "./dist/feedback.js",
      "node": "./dist/ssr/feedback.js",
      "import": "./dist/feedback.js",
      "default": "./dist/feedback.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "browser": "./dist/layout.js",
      "node": "./dist/ssr/layout.js",
      "import": "./dist/layout.js",
      "default": "./dist/layout.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "browser": "./dist/data.js",
      "node": "./dist/ssr/data.js",
      "import": "./dist/data.js",
      "default": "./dist/data.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "browser": "./dist/recipes.js",
      "node": "./dist/ssr/recipes.js",
      "import": "./dist/recipes.js",
      "default": "./dist/recipes.js"
    },
    "./styles/recipes.css": "./dist/styles/recipes.css",
    "./styles/layout.css": "./dist/styles/layout.css",
    "./styles/data.css": "./dist/styles/data.css",
    "./styles/sortable-header.css": "./dist/styles/sortable-header.css",
    "./styles/feedback.css": "./dist/styles/feedback.css",
    "./styles/forms.css": "./dist/styles/forms.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && vite build && vite build --ssr src/index.ts --outDir dist/ssr && tsrs -p tsconfig.json && node scripts/build-css.mjs",
    "lint": "oxlint",
    "typecheck": "tsrs -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepack": "pnpm run build",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2.0.0-rc.18",
    "solid-js": ">=2.0.0-rc.18"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@solidjs/vite-plugin": "3.0.0-next.54",
    "@solidjs/web": "2.0.0-rc.20",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "solid-js": "2.0.0-rc.20",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.13.0"
  }
}
